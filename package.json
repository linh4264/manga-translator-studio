{
  "name": "manga-translator-studio",
  "version": "2.5.0",
  "description": "Manga Translator Studio - AI Translation, Inpainting & Typesetting Tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:regression": "vitest run tests/regression",
    "test:core": "vitest run tests/unit/core",
    "test:ai": "vitest run tests/unit/ai",
    "test:canvas": "vitest run tests/unit/canvas",
    "test:ocr": "vitest run tests/unit/ocr",
    "test:io": "vitest run tests/unit/io",
    "test:inpainting": "vitest run tests/unit/inpainting",
    "test:bun": "bun test",
    "start": "node server/server.js"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^3.11.174"
  },
  "keywords": [
    "manga",
    "translator",
    "gemini",
    "claude",
    "openai",
    "typesetting",
    "inpainting",
    "scanlation"
  ],
  "author": "Manga Translator Studio Team",
  "license": "MIT"
}
