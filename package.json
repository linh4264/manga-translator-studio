{
  "name": "manga-translator-studio",
  "version": "2.5.0",
  "description": "Manga Translator Studio - AI Translation, Inpainting & Typesetting Tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "bun test || vitest run",
    "test:bun": "bun test",
    "test:watch": "vitest",
    "test:node": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:regression": "node --test tests/regression/**/*.test.js",
    "test:core": "node --test tests/unit/core/**/*.test.js",
    "test:ai": "node --test tests/unit/ai/**/*.test.js",
    "test:canvas": "node --test tests/unit/canvas/**/*.test.js",
    "test:ocr": "node --test tests/unit/ocr/**/*.test.js",
    "test:io": "node --test tests/unit/io/**/*.test.js",
    "test:inpainting": "node --test tests/unit/inpainting/**/*.test.js",
    "start": "node server/server.js"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "manga",
    "translator",
    "gemini",
    "claude",
    "openai",
    "typesetting",
    "inpainting",
    "scanlation"
  ],
  "author": "Manga Translator Studio Team",
  "license": "MIT"
}
